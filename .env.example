DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Xác thực chủ sở hữu (sinh bằng `node scripts/auth-setup.mjs secret|hash`, không commit giá trị thật)
AUTH_SESSION_SECRET="<chuỗi ngẫu nhiên ≥ 32 ký tự>"
# Trong .env.local, Next.js thay thế `$...`: thêm `\` trước MỖI dấu `$` của hash.
# Trên Vercel (Environment Variables) dán nguyên bản, không thêm `\`.
AUTH_OWNER_PASSWORD_HASH="scrypt\$32768\$8\$1\$<salt>\$<hash>"

# Nút "Cập nhật tướng" (tuỳ chọn): kích hoạt workflow .github/workflows/update-heroes.yml.
# Fine-grained token, chỉ repo này, quyền Actions: Read and write. Thiếu → nút bị tắt.
GITHUB_HEROES_TOKEN=""
# Mặc định lấy từ VERCEL_GIT_REPO_OWNER/VERCEL_GIT_REPO_SLUG trên Vercel; local cần ghi rõ.
GITHUB_HEROES_REPO="<owner>/<repo>"
GITHUB_HEROES_REF="main"
